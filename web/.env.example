# Copy to .env.local and fill in. Never commit real keys (.env* is gitignored).

# --- Klaviyo (email capture) -------------------------------------------------
# Private API key from Klaviyo → Settings → API keys (starts with pk_)
KLAVIYO_PRIVATE_KEY=
# List ID from Klaviyo → Lists & Segments → your list → Settings (6-char code)
KLAVIYO_LIST_ID=
# Optional: pin the API revision (default 2024-10-15)
# KLAVIYO_REVISION=2024-10-15

# --- Gated downloads ---------------------------------------------------------
# Long random string. Signs free-kit download links. Changing it invalidates old links.
# Generate: openssl rand -hex 32
DOWNLOAD_SECRET=

# --- Site --------------------------------------------------------------------
# Absolute site URL, used for OG images and the download links emailed to subscribers.
NEXT_PUBLIC_SITE_URL=https://slapgodmadeit.com

# --- Stripe (checkout) — see docs/STRIPE-SETUP.md ----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_AUTOMATIC_TAX=true

# --- Paid file storage (Vercel Blob, private) ---------------------------------
BLOB_READ_WRITE_TOKEN=
