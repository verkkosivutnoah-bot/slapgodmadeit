# Beat bot — copy to tools/.env and fill in. tools/.env is gitignored.

# From @BotFather: create a NEW bot (separate from the loop bot), e.g. @slapgod_beats_bot
BEAT_BOT_TOKEN=

# Your Telegram user id. Send /id to the bot to get it. Comma-separate for several.
OWNER_IDS=

# true  = build only, never commit or push (safe while testing)
# false = publish for real: commit + push → Vercel deploys
TEST_MODE=true

SITE_URL=https://slapgodmadeit.vercel.app
