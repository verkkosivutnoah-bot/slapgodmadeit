# From @BotFather
BOT_TOKEN=123456789:ABCdef...
# Your loop channel: @username for public, or -100xxxxxxxxxx for private
CHANNEL_ID=@your_loop_channel
# Your Telegram user id (send /id to the bot). Comma-separate for multiple.
OWNER_IDS=
# true = send posts back to your chat only (channel untouched). Set false to go live.
TEST_MODE=true
# Hashtags used when nothing was chosen yet
DEFAULT_TAGS="#spanish #guitarloop"
ARTIST_NAME=SLAPGOD
# Hashtag buttons the bot offers, separated by |
TAG_PRESETS="#painmelody #guitarloop|#spanish #guitarloop|#rnb #guitarloop"
