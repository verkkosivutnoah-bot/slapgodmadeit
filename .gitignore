node_modules/
.next/
.vercel/
.env*
!.env.example
*.tsbuildinfo

# Ingested beat masters and stems stay local; the tagged free-download file ships
# (it's the tagged version, and production needs it to serve /api/free-download).
web/private/beats/*
!web/private/beats/*/
web/private/beats/*/*
!web/private/beats/*/*-tagged.m4a
!web/private/beats/*/meta.json
